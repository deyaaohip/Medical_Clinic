# Base44 development placeholders. Loaded BEFORE /run/base44/app.env so any
# value the user supplies from the dashboard always wins.
# Replace with a real secret for anything beyond local preview.
JWT_SECRET=base44-development-placeholder-jwt-secret-change-me

# Persona demo sign-in (no password). Only enabled for the local preview: with the
# flag unset, /api/auth/demo-login rejects every request, so a production deployment
# cannot be signed into without real credentials.
DEMO_AUTH_ENABLED=1
